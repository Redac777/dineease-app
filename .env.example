# .env.example — modèle versionné (valeurs VIDES). Copie-le en .env et renseigne les vraies valeurs.
# Le .env réel est gitignoré : ne le pousse JAMAIS. Ne mets jamais de secret dans un fichier versionné.

# --- Supabase (base, auth, temps réel, stockage) ---
NEXT_PUBLIC_SUPABASE_URL=            # URL du projet Supabase (exposée au navigateur, sans danger)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # clé publique Supabase (exposée au navigateur, protégée par RLS)
SUPABASE_SERVICE_ROLE_KEY=           # clé ADMIN, SERVEUR UNIQUEMENT (jamais côté client)

# --- App ---
NEXT_PUBLIC_APP_URL=                 # URL de base de l'app (sert à fabriquer les liens des QR codes)

# --- Outillage collaboratif (le kit) ---
GITHUB_TOKEN=                        # PAT classic (ghp_, scope repo) : PR + protection de branche par l'agent

# --- Paiement (module billing, DERNIER) ---
# Le prestataire n'est pas encore choisi (compatibilité Maroc à étudier : CMI, YouCan Pay, PayZone,
# Paddle/Lemon Squeezy...). Les variables seront ajoutées ici quand le module billing sera construit.
